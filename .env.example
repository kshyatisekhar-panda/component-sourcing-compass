# Component Sourcing Compass — local environment template
# Copy to .env and fill in real values. .env is gitignored.

# Mouser Electronics API key — used by compare_with_mouser and the market
# price column of the sourcing report. Sign up at mouser.com.
MOUSER_API_KEY=your-mouser-api-key

# Tavily search API key — used for cross-product suggestion lookups.
# Get one at tavily.com.
TAVILY_API_KEY=your-tavily-api-key

# OpenRouter API key — used by generate_compliance_report to compose the
# certificate prose with Claude. Get one at openrouter.ai.
OPENROUTER_API_KEY=your-openrouter-api-key
