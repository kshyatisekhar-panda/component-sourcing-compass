{
  "name": "component-sourcing-compass",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "MCP server for AI-assisted component sourcing and compliance verification (Atlas Copco hackathon PoC).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"data/**/*.json\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
